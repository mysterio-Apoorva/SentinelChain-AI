{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/production.mjs dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1085.0",
    "@aws-sdk/client-dynamodb": "^3.1088.0",
    "@aws-sdk/client-eventbridge": "^3.1101.0",
    "@aws-sdk/client-lambda": "^3.1089.0",
    "@aws-sdk/client-sns": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1088.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "aws-amplify": "^6.18.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}

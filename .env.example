# Server (Node.js 22+)
PORT=3000
AWS_REGION=us-east-1
# Prefer the deployment platform's IAM role/default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Cognito public identifiers, used at frontend BUILD time.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Optional server overrides; otherwise the server uses the two values above.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional analysis integrations. DynamoDB table partition key: id (String).
DYNAMODB_TABLE=
LAMBDA_FUNCTION_NAME=
EVENT_BUS_NAME=

# Separate SNS topics with subscriptions configured for each channel.
# Success means SNS accepted the message, not confirmed recipient delivery.
SNS_EMAIL_TOPIC_ARN=
SNS_SMS_TOPIC_ARN=
SNS_SLACK_TOPIC_ARN=
SNS_PAGERDUTY_TOPIC_ARN=

# Operational data adapter (GET JSON); see README for response keys.
DATA_SOURCE_URL=
DATA_SOURCE_TOKEN=
# Execution adapter (POST JSON); must implement Idempotency-Key handling.
OPERATIONS_WEBHOOK_URL=
OPERATIONS_WEBHOOK_TOKEN=
